<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com" xmlns:fx="http://javafx.com"
      stylesheets="@css/style.css"
      fx:controller="main.java.controller.PelangganTableController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <GridPane hgap="10.0" vgap="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label text="Nama:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="namaField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Alamat:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="alamatField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <children>
                        <Button onAction="#handleSubmit" text="Submit" styleClass="custom-button"/>
                        <Button onAction="#handleUpdate" text="Update" styleClass="custom-button"/>
                        <Button onAction="#handleDelete" text="Delete" styleClass="custom-button"/>
                    </children>
                </HBox>
            </children>
        </GridPane>

        <TableView fx:id="pelangganTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="namaCol" text="Nama" prefWidth="200"/>
                <TableColumn fx:id="alamatCol" text="Alamat" prefWidth="400"/>
            </columns>
        </TableView>
    </children>
</VBox>